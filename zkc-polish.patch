+// Bind with:  (i0, i1, i2, i3) = canonical_low4(v);
+// Goldilocks only — compile with --field goldilocks. The canonicity check is
+// arithmetic about p and means nothing over another field.
+gadget canonical_low4(v: field) -> (i0: field, i1: field, i2: field, i3: field) {
+    advice (b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35, b36, b37, b38, b39, b40, b41, b42, b43, b44, b45, b46, b47, b48, b49, b50, b51, b52, b53, b54, b55, b56, b57, b58, b59, b60, b61, b62, b63) = bits(v);
+
+    // The low 32 bits as a value: zero exactly when the string's low half is.
+    let lo0 = b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7;
+    let lo1 = 256 * b8 + 512 * b9 + 1024 * b10 + 2048 * b11 + 4096 * b12 + 8192 * b13 + 16384 * b14 + 32768 * b15;
+    let lo2 = 65536 * b16 + 131072 * b17 + 262144 * b18 + 524288 * b19 + 1048576 * b20 + 2097152 * b21 + 4194304 * b22 + 8388608 * b23;
+    let lo3 = 16777216 * b24 + 33554432 * b25 + 67108864 * b26 + 134217728 * b27 + 268435456 * b28 + 536870912 * b29 + 1073741824 * b30 + 2147483648 * b31;
+    let lo = lo0 + lo1 + lo2 + lo3;
+
+    // ones30 == 1 exactly when every one of the top 32 bits is set.
+    let ones0 = b32 * b33;
+    let ones1 = ones0 * b34;
+    let ones2 = ones1 * b35;
+    let ones3 = ones2 * b36;
+    let ones4 = ones3 * b37;
+    let ones5 = ones4 * b38;
+    let ones6 = ones5 * b39;
+    let ones7 = ones6 * b40;
+    let ones8 = ones7 * b41;
+    let ones9 = ones8 * b42;
+    let ones10 = ones9 * b43;
+    let ones11 = ones10 * b44;
+    let ones12 = ones11 * b45;
+    let ones13 = ones12 * b46;
+    let ones14 = ones13 * b47;
+    let ones15 = ones14 * b48;
+    let ones16 = ones15 * b49;
+    let ones17 = ones16 * b50;
+    let ones18 = ones17 * b51;
+    let ones19 = ones18 * b52;
+    let ones20 = ones19 * b53;
+    let ones21 = ones20 * b54;
+    let ones22 = ones21 * b55;
+    let ones23 = ones22 * b56;
+    let ones24 = ones23 * b57;
+    let ones25 = ones24 * b58;
+    let ones26 = ones25 * b59;
+    let ones27 = ones26 * b60;
+    let ones28 = ones27 * b61;
+    let ones29 = ones28 * b62;
+    let ones30 = ones29 * b63;
+
+    // Canonicity: a string with all top bits set may only be p - 1's, whose
+    // low half is zero. Every other non-canonical string dies here.
+    assert ones30 * lo == 0;
+
+    // The low bit(s), read off the pinned decomposition.
+    assert i0 == b0;
+    assert i1 == b1;
+    assert i2 == b2;
+    assert i3 == b3;
+}
